# Postgres (Neon). Lokal z. B. ein Neon-Branch oder ein lokaler Postgres.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# better-auth
BETTER_AUTH_SECRET=   # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:5173

# GitHub OAuth App (Callback: <BETTER_AUTH_URL>/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Kommagetrennte GitHub-Logins, die sich anmelden dürfen
ALLOWED_GITHUB_LOGINS=mrclhng
